<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FreeMail" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fm_bg</item>
        <item name="android:colorAccent">@color/fm_accent</item>
        <item name="android:colorPrimary">@color/fm_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ system splash: brand violet + white envelope, then SplashView takes over -->
        <item name="android:windowSplashScreenBackground">#6D3FE6</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#6D3FE6</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
